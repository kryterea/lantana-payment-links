PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Public base URL used to build shareable links, e.g. https://myshop.example.com
APP_BASE_URL=http://localhost:3000
# Pending payments expire after this many hours (default 24)
PENDING_TTL_HOURS=24
# Repeat Pay taps for the same link + email reuse the pending ref within this many minutes (default 30)
PENDING_REUSE_MINUTES=30
